# Koneksi MySQL (XAMPP bawaan: user root, tanpa password, database "kosku")
# Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# Jika root punya password: mysql://root:PASSWORDKU@localhost:3306/kosku
DATABASE_URL="mysql://root:@localhost:3306/kosku"

# Kunci rahasia untuk menandatangani JWT. GANTI untuk produksi.
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter-ya"
